<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý tài khoản - Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            margin: 0;
            background: #f5f5f5;
            color: #222;
        }

        .admin-page {
            min-height: 100vh;
            padding: 32px 20px;
        }

        .admin-wrapper {
            max-width: 1280px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 24px;
        }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 34px;
            font-weight: 700;
        }

        .page-header p {
            margin: 0;
            color: #666;
            font-size: 15px;
        }

        .top-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 20px 0 24px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            padding: 0 16px;
            border: none;
            border-radius: 999px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .btn-primary {
            background: #ff5a3c;
            color: #fff;
        }

        .btn-outline {
            background: #fff;
            color: #333;
            border: 1px solid #ddd;
        }

        .btn-danger {
            background: #fff2f2;
            color: #c62828;
            border: 1px solid #f3c1c1;
        }

        .alert {
            padding: 14px 16px;
            border-radius: 12px;
            margin-bottom: 18px;
            font-size: 14px;
            font-weight: 600;
        }

        .alert-success {
            background: #e9f9ef;
            color: #1d7a3d;
            border: 1px solid #bde7c9;
        }

        .alert-error {
            background: #fff0f0;
            color: #c62828;
            border: 1px solid #f3c1c1;
        }

        .table-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1100px;
        }

        th, td {
            padding: 14px 16px;
            border-bottom: 1px solid #eee;
            text-align: left;
            vertical-align: top;
            font-size: 14px;
        }

        th {
            background: #fafafa;
            font-weight: 700;
        }

        .role-badge {
            display: inline-flex;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .role-admin {
            background: #ffe7cc;
            color: #b56a00;
        }

        .role-user {
            background: #e9f3ff;
            color: #1565c0;
        }

        .password-box {
            font-family: monospace;
            background: #fafafa;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 6px 10px;
            display: inline-block;
        }

        .action-form {
            margin: 0;
        }
    </style>
</head>
<body>
<div class="admin-page">
    <div class="admin-wrapper">
        <div class="page-header">
            <h1>Quản lý tài khoản</h1>
            <p>Xem thông tin user, mật khẩu hiện tại và xóa tài khoản khi cần.</p>
        </div>

        <div class="top-actions">
            <a href="/admin" class="btn btn-outline">
                <i class="fa-solid fa-chart-line"></i>
                Dashboard
            </a>

            <a href="/admin/orders" class="btn btn-outline">
                <i class="fa-solid fa-file-invoice"></i>
                Quản lý đơn hàng
            </a>

            <a href="/admin/products" class="btn btn-primary">
                <i class="fa-solid fa-box"></i>
                Quản lý sản phẩm
            </a>
        </div>

        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <div class="table-card">
            <div class="table-wrap">
                <table>
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Mật khẩu</th>
                        <th>Vai trò</th>
                        <th>Họ tên</th>
                        <th>SĐT</th>
                        <th>Địa chỉ</th>
                        <th>Hành động</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% if (!users || users.length === 0) { %>
                        <tr>
                            <td colspan="8">Chưa có tài khoản nào.</td>
                        </tr>
                    <% } else { %>
                        <% users.forEach((user) => { %>
                            <tr>
                                <td>#<%= user.id %></td>
                                <td><%= user.email %></td>
                                <td>
                                    <span class="password-box"><%= user.password %></span>
                                </td>
                                <td>
                                    <span class="role-badge <%= user.role === 'admin' ? 'role-admin' : 'role-user' %>">
                                        <%= user.role %>
                                    </span>
                                </td>
                                <td><%= user.full_name || '-' %></td>
                                <td><%= user.phone || '-' %></td>
                                <td><%= user.address || '-' %></td>
                                <td>
                                    <% if (user.role !== "admin") { %>
                                        <form action="/admin/users/delete/<%= user.id %>" method="POST" class="action-form" onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản này không?');">
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fa-solid fa-trash"></i>
                                                Xóa
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span class="btn btn-outline" style="cursor:default;">Admin</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</body>
</html>