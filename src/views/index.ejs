<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("searchInput");
        const searchDropdown = document.getElementById("searchDropdown");
        const searchSuggestList = document.getElementById("searchSuggestList");
        const clearAllHistoryBtn = document.getElementById("clearAllHistoryBtn");
        const searchForm = document.getElementById("searchForm");

        let debounceTimer;

        function showDropdown() {
            if (searchDropdown) searchDropdown.classList.add("show");
        }

        function hideDropdown() {
            if (searchDropdown) searchDropdown.classList.remove("show");
        }

        async function saveSearchHistory(keyword) {
            try {
                const res = await fetch("/search/history", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ keyword })
                });
                return await res.json();
            } catch (err) {
                console.error("SAVE SEARCH HISTORY CLIENT ERROR:", err);
                return { success: false };
            }
        }

        async function deleteOneHistory(keyword) {
            try {
                await fetch("/search/history/delete", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ keyword })
                });
                window.location.reload();
            } catch (err) {
                console.error("DELETE ONE HISTORY CLIENT ERROR:", err);
            }
        }

        async function clearAllHistory() {
            try {
                await fetch("/search/history/clear", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" }
                });
                window.location.reload();
            } catch (err) {
                console.error("CLEAR ALL HISTORY CLIENT ERROR:", err);
            }
        }

        async function fetchSuggestions(keyword) {
            try {
                const res = await fetch(`/search/suggest?q=${encodeURIComponent(keyword)}`);
                const data = await res.json();
                renderSuggestions(data);
            } catch (err) {
                console.error("FETCH SUGGESTIONS ERROR:", err);
            }
        }

        function renderSuggestions(items) {
            if (!searchSuggestList) return;

            if (!items || items.length === 0) {
                searchSuggestList.innerHTML = "";
                return;
            }

            searchSuggestList.innerHTML = items.map(item => `
                <li class="header__search-suggest-item">
                    <a class="header__search-suggest-link" href="/product/${item.id}">
                        <div class="search-suggest-item-content">
                            <img class="search-suggest-thumb" src="${item.image || ''}" alt="${item.name || ''}">
                            <div>
                                <div class="search-suggest-name">${item.name || ""}</div>
                                <div class="search-suggest-price">${Number(item.price || 0).toLocaleString("vi-VN")}đ</div>
                            </div>
                        </div>
                    </a>
                </li>
            `).join("");
        }

        if (searchInput) {
            searchInput.addEventListener("focus", function () {
                showDropdown();
            });

            searchInput.addEventListener("input", function (e) {
                const keyword = e.target.value.trim();
                showDropdown();
                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(() => {
                    if (keyword.length > 0) {
                        fetchSuggestions(keyword);
                    } else {
                        renderSuggestions([]);
                    }
                }, 250);
            });
        }

        document.addEventListener("click", function (e) {
            if (searchForm && !searchForm.contains(e.target)) {
                hideDropdown();
            }
        });

        document.querySelectorAll(".search-history-delete-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                const keyword = this.getAttribute("data-keyword");
                if (keyword) deleteOneHistory(keyword);
            });
        });

        if (clearAllHistoryBtn) {
            clearAllHistoryBtn.addEventListener("click", function () {
                clearAllHistory();
            });
        }

        if (searchForm) {
            searchForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                const keyword = searchInput ? searchInput.value.trim() : "";
                if (!keyword) {
                    this.submit();
                    return;
                }

                await saveSearchHistory(keyword);
                this.submit();
            });
        }
    });
</script>
