<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh toán - TKD Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            margin: 0;
            background: linear-gradient(180deg, #f8f8f8 0%, #efefef 100%);
            color: #222;
        }

        .checkout-page {
            min-height: 100vh;
            padding: 40px 20px;
        }

        .checkout-wrapper {
            max-width: 1150px;
            margin: 0 auto;
        }

        .checkout-title {
            margin: 0 0 24px;
            font-size: 40px;
            font-weight: 800;
        }

        .checkout-grid {
            display: grid;
            grid-template-columns: 1.5fr 0.9fr;
            gap: 24px;
        }

        .card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
            padding: 24px;
        }

        .section-title {
            margin: 0 0 18px;
            font-size: 24px;
            font-weight: 700;
        }

        .section-subtitle {
            margin: 0 0 18px;
            color: #666;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 700;
            color: #333;
        }

        input,
        textarea {
            width: 100%;
            border: 1px solid #ddd;
            border-radius: 12px;
            padding: 13px 14px;
            font-size: 15px;
            outline: none;
            transition: 0.2s ease;
            background: #fff;
        }

        textarea {
            min-height: 110px;
            resize: vertical;
        }

        input:focus,
        textarea:focus {
            border-color: #ff5a3c;
            box-shadow: 0 0 0 4px rgba(255, 90, 60, 0.12);
        }

        .payment-methods {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 8px;
        }

        .payment-option {
            border: 1px solid #e5e5e5;
            border-radius: 14px;
            padding: 16px;
            cursor: pointer;
            transition: 0.2s ease;
            background: #fafafa;
        }

        .payment-option:hover {
            border-color: #ff5a3c;
            background: #fff;
        }

        .payment-option input {
            width: auto;
            margin-right: 10px;
        }

        .payment-option-title {
            font-size: 15px;
            font-weight: 700;
            color: #222;
        }

        .payment-option-desc {
            margin-top: 6px;
            font-size: 14px;
            color: #666;
            line-height: 1.6;
        }

        .qr-box {
            display: none;
            margin-top: 16px;
            border: 1px dashed #ff5a3c;
            border-radius: 14px;
            padding: 18px;
            background: #fff7f4;
        }

        .qr-box.active {
            display: block;
        }

        .qr-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 12px;
            color: #222;
        }

        .qr-image-wrap {
            text-align: center;
            margin-bottom: 14px;
        }

        .qr-image {
            max-width: 220px;
            width: 100%;
            border-radius: 12px;
            background: #fff;
            padding: 8px;
            border: 1px solid #eee;
        }

        .bank-info {
            font-size: 14px;
            color: #444;
            line-height: 1.8;
        }

        .bank-info strong {
            color: #111;
        }

        .summary-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .summary-item {
            display: flex;
            gap: 12px;
            padding-bottom: 14px;
            border-bottom: 1px solid #eee;
        }

        .summary-image {
            width: 68px;
            height: 68px;
            border-radius: 12px;
            object-fit: cover;
            background: #f3f3f3;
            flex-shrink: 0;
        }

        .summary-content {
            flex: 1;
            min-width: 0;
        }

        .summary-name {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .summary-meta {
            font-size: 14px;
            color: #666;
        }

        .summary-line {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            font-size: 15px;
            margin-top: 12px;
            color: #444;
        }

        .summary-line.discount {
            color: #0a8f4d;
            font-weight: 700;
        }

        .summary-line.shipping {
            color: #444;
        }

        .summary-total {
            margin-top: 18px;
            padding-top: 16px;
            border-top: 2px solid #f0f0f0;
            font-size: 18px;
            font-weight: 700;
        }

        .summary-total strong {
            font-size: 32px;
            color: #ff5a3c;
        }

        .action-row {
            margin-top: 20px;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 46px;
            padding: 0 20px;
            border: none;
            border-radius: 999px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .btn-primary {
            background: #ff5a3c;
            color: #fff;
        }

        .btn-primary:hover {
            opacity: 0.92;
            transform: translateY(-1px);
        }

        .btn-outline {
            background: #fff;
            color: #333;
            border: 1px solid #ddd;
        }

        .btn-outline:hover {
            border-color: #ff5a3c;
            color: #ff5a3c;
        }

        .saved-note {
            margin-bottom: 18px;
            padding: 14px 16px;
            border-radius: 12px;
            background: #eef7ff;
            border: 1px solid #cfe6ff;
            color: #1d5fa8;
            font-size: 14px;
            line-height: 1.6;
        }

        .voucher-note {
            margin-top: 8px;
            font-size: 13px;
            color: #666;
            line-height: 1.5;
        }

        .transfer-code-box {
            margin-top: 12px;
            padding: 12px 14px;
            background: #fff;
            border: 1px solid #ffd2c7;
            border-radius: 10px;
            font-size: 14px;
            color: #333;
        }

        .transfer-code-box strong {
            color: #ff5a3c;
            font-size: 15px;
        }

        .voucher-row {
            display: flex;
            gap: 10px;
            align-items: stretch;
        }

        .voucher-row input {
            flex: 1;
        }

        .btn-apply-voucher {
            min-width: 110px;
            border: none;
            border-radius: 12px;
            background: #ff5a3c;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            padding: 0 18px;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .btn-apply-voucher:hover {
            opacity: 0.92;
            transform: translateY(-1px);
        }

        .voucher-message {
            margin-top: 10px;
            font-size: 13px;
            font-weight: 700;
        }

        .voucher-message.success {
            color: #0a8f4d;
        }

        .voucher-message.error {
            color: #d93025;
        }

        @media (max-width: 900px) {
            .checkout-grid {
                grid-template-columns: 1fr;
            }

            .checkout-title {
                font-size: 32px;
            }
        }

        @media (max-width: 640px) {
            .voucher-row {
                flex-direction: column;
            }

            .btn-apply-voucher {
                min-height: 46px;
                width: 100%;
            }
        }
    </style>
</head>
<body>
<div class="checkout-page">
    <div class="checkout-wrapper">
        <h1 class="checkout-title">Thanh toán</h1>

        <%
        let subtotal = 0;
        cart.forEach(item => {
            subtotal += (item.price || 0) * (item.qty || 1);
        });

        const shippingFeeValue = typeof shippingFee !== "undefined" ? shippingFee : (subtotal >= 500000 ? 0 : 30000);
        const discountAmountValue = typeof discountAmount !== "undefined" ? discountAmount : 0;
        const finalTotalValue = typeof finalTotal !== "undefined"
                ? finalTotal
                : (subtotal + shippingFeeValue - discountAmountValue);

        function formatPrice(price) {
            return Number(price || 0).toLocaleString("vi-VN") + "đ";
        }

        const previewTransferCode = profileUser ? ("TKDSHOP-USER-" + profileUser.id) : "TKDSHOP-KHACH";
        %>

        <div class="checkout-grid">
            <div class="card">
                <h2 class="section-title">Thông tin giao hàng</h2>
                <p class="section-subtitle">Bạn có thể dùng thông tin đã lưu trong profile hoặc chỉnh sửa trước khi đặt hàng.</p>

                <% if (profileUser) { %>
                    <div class="saved-note">
                        Thông tin đã lưu từ tài khoản của bạn đã được tự động điền sẵn bên dưới.
                    </div>
                <% } %>

                <form action="/checkout" method="POST" id="checkoutForm">
                    <input type="hidden" name="applied_voucher_code" id="appliedVoucherCode" value="<%= typeof appliedVoucherCode !== 'undefined' ? appliedVoucherCode : '' %>">

                    <div class="form-group">
                        <label for="name">Họ và tên người nhận</label>
                        <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Nhập họ và tên"
                                value="<%= profileUser && profileUser.full_name ? profileUser.full_name : '' %>"
                                required
                        >
                    </div>

                    <div class="form-group">
                        <label for="phone">Số điện thoại</label>
                        <input
                                type="text"
                                id="phone"
                                name="phone"
                                placeholder="Nhập số điện thoại"
                                value="<%= profileUser && profileUser.phone ? profileUser.phone : '' %>"
                                required
                        >
                    </div>

                    <div class="form-group">
                        <label for="address">Địa chỉ giao hàng</label>
                        <textarea
                                id="address"
                                name="address"
                                placeholder="Nhập địa chỉ giao hàng"
                                required
                        ><%= profileUser && profileUser.address ? profileUser.address : '' %></textarea>
                    </div>

                    <div class="form-group" style="margin-top: 24px;">
                        <label for="voucher_code">Mã giảm giá</label>

                        <div class="voucher-row">
                            <input
                                    type="text"
                                    id="voucher_code"
                                    name="voucher_code"
                                    placeholder="Nhập mã giảm giá, ví dụ: GIAM50K"
                                    value="<%= typeof appliedVoucherCode !== 'undefined' ? appliedVoucherCode : '' %>"
                            >

                            <button type="button" id="applyVoucherBtn" class="btn-apply-voucher">
                                Áp mã
                            </button>
                        </div>

                        <div class="voucher-note">
                            Bạn có thể nhập mã giảm giá nếu có. Phí vận chuyển sẽ được tính tự động theo tổng giá trị đơn hàng.
                        </div>

                        <div id="voucherMessage" class="voucher-message"></div>
                    </div>

                    <h2 class="section-title" style="margin-top: 28px;">Phương thức thanh toán</h2>

                    <div class="payment-methods">
                        <label class="payment-option">
                            <div>
                                <input
                                        type="radio"
                                        name="payment_method"
                                        value="cod"
                                        checked
                                        onchange="toggleQRCode()"
                                >
                                <span class="payment-option-title">Thanh toán khi nhận hàng (COD)</span>
                            </div>
                            <div class="payment-option-desc">
                                Bạn thanh toán trực tiếp cho shipper khi nhận được hàng.
                            </div>
                        </label>

                        <label class="payment-option">
                            <div>
                                <input
                                        type="radio"
                                        name="payment_method"
                                        value="bank_qr"
                                        onchange="toggleQRCode()"
                                >
                                <span class="payment-option-title">Chuyển khoản bằng mã QR</span>
                            </div>
                            <div class="payment-option-desc">
                                Quét mã QR để chuyển khoản trước. Sau đó bấm đặt hàng để hệ thống tạo mã thanh toán cho đơn.
                            </div>
                        </label>
                    </div>

                    <label class="payment-option">
                        <div>
                            <input
                                type="radio"
                                name="payment_method"
                                value="online_sandbox"

                                onchange="toggleQRCode()"
                            >
                            <span class="payment-option-title">
                                Thanh toán online (Sandbox)
                            </span>
                        </div>
                        <div class="payment-option-desc">
                            Đang chuẩn bị tích hợp cổng thanh toán thử nghiệm.
                        </div>
                    </label>

                    <div id="qrBox" class="qr-box">
                        <div class="qr-title">Thông tin chuyển khoản</div>

                        <div class="qr-image-wrap">
                            <img
                                    src="/legacy/source_code-byTKD/assets/img/QR.jpg"
                                    alt="QR chuyển khoản"
                                    class="qr-image"
                            >
                        </div>

                        <div class="bank-info">
                            <div><strong>Ngân hàng:</strong> Vietcombank</div>
                            <div><strong>Số tài khoản:</strong> 1038983184</div>
                            <div><strong>Chủ tài khoản:</strong> TRAN KHANH DANG</div>
                            <div><strong>Số tiền tạm tính:</strong> <span id="qrAmountText"><%= formatPrice(finalTotalValue) %></span></div>
                        </div>

                        <div class="transfer-code-box">
                            <div><strong>Nội dung chuyển khoản mẫu:</strong></div>
                            <div><%= previewTransferCode %></div>
                            <div style="margin-top: 8px; color: #666;">
                                Sau khi bấm <strong>Đặt hàng</strong>, hệ thống sẽ tạo <strong>mã chuyển khoản riêng theo từng đơn</strong> để đối chiếu thanh toán tự động.
                            </div>
                        </div>
                    </div>

                    <div class="action-row">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-bag-shopping"></i>
                            Đặt hàng
                        </button>

                        <a href="/cart" class="btn btn-outline">
                            <i class="fa-solid fa-arrow-left"></i>
                            Quay lại giỏ hàng
                        </a>
                    </div>
                </form>
            </div>

            <div class="card">
                <h2 class="section-title">Đơn hàng của bạn</h2>

                <div class="summary-list">
                    <% cart.forEach((item) => { %>
                        <div class="summary-item">
                            <img src="<%= item.image %>" alt="<%= item.name %>" class="summary-image">

                            <div class="summary-content">
                                <div class="summary-name"><%= item.name %></div>
                                <div class="summary-meta">
                                    Số lượng: <%= item.qty %> · Giá: <%= formatPrice(item.price) %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="summary-line">
                    <span>Tạm tính:</span>
                    <span id="subtotalText"><%= formatPrice(subtotal) %></span>
                </div>

                <div class="summary-line shipping">
                    <span>Phí vận chuyển:</span>
                    <span id="shippingFeeText"><%= formatPrice(shippingFeeValue) %></span>
                </div>

                <div class="summary-line discount">
                    <span>Giảm giá:</span>
                    <span id="discountAmountText">- <%= formatPrice(discountAmountValue) %></span>
                </div>

                <div class="summary-total">
                    Tổng thanh toán:
                    <br>
                    <strong id="finalTotalText"><%= formatPrice(finalTotalValue) %></strong>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleQRCode() {
        const qrRadio = document.querySelector('input[name="payment_method"][value="bank_qr"]');
        const qrBox = document.getElementById("qrBox");

        if (qrRadio && qrRadio.checked) {
            qrBox.classList.add("active");
        } else {
            qrBox.classList.remove("active");
        }
    }

    function formatPriceClient(value) {
        return Number(value || 0).toLocaleString("vi-VN") + "đ";
    }

    async function applyVoucherPreview() {
        const voucherInput = document.getElementById("voucher_code");
        const messageBox = document.getElementById("voucherMessage");
        const appliedVoucherCode = document.getElementById("appliedVoucherCode");

        const voucherCode = voucherInput ? voucherInput.value.trim() : "";

        messageBox.className = "voucher-message";
        messageBox.textContent = "";

        try {
            const res = await fetch("/checkout/apply-voucher-preview", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    voucher_code: voucherCode
                })
            });

            const data = await res.json();

            if (!data.success) {
                messageBox.classList.add("error");
                messageBox.textContent = data.message || "Mã giảm giá không hợp lệ";
                appliedVoucherCode.value = "";
                return;
            }

            document.getElementById("subtotalText").textContent = formatPriceClient(data.subtotal);
            document.getElementById("shippingFeeText").textContent = formatPriceClient(data.shippingFee);
            document.getElementById("discountAmountText").textContent = "- " + formatPriceClient(data.discountAmount);
            document.getElementById("finalTotalText").textContent = formatPriceClient(data.finalTotal);
            document.getElementById("qrAmountText").textContent = formatPriceClient(data.finalTotal);

            appliedVoucherCode.value = data.voucherCode || "";

            messageBox.classList.add("success");
            messageBox.textContent = data.message || "Áp mã thành công";
        } catch (err) {
            console.error("APPLY VOUCHER PREVIEW ERROR:", err);
            messageBox.classList.add("error");
            messageBox.textContent = "Không thể áp mã lúc này";
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        toggleQRCode();

        const applyBtn = document.getElementById("applyVoucherBtn");
        if (applyBtn) {
            applyBtn.addEventListener("click", applyVoucherPreview);
        }
    });
</script>
</body>
</html>