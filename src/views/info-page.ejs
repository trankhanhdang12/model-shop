<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TKD Shop</title>
    <link rel="stylesheet" href="/legacy/source_code-byTKD/assets/fontawesome-free-6.6.0-web/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #333;
        }

        .page {
            max-width: 1080px;
            margin: 30px auto;
            padding: 0 16px;
        }

        .hero {
            background: linear-gradient(135deg, #ee4d2d, #ff7337);
            color: #fff;
            border-radius: 18px;
            padding: 28px 30px;
            margin-bottom: 24px;
            box-shadow: 0 10px 28px rgba(0,0,0,0.08);
        }

        .hero-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .hero h1 {
            margin: 0;
            font-size: 34px;
            font-weight: 800;
        }

        .hero p {
            margin: 10px 0 0;
            font-size: 15px;
            line-height: 1.7;
            opacity: 0.96;
        }

        .btn-home {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            background: #fff;
            color: #ee4d2d;
            padding: 12px 16px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 14px;
        }

        .content-card {
            background: #fff;
            border-radius: 18px;
            padding: 22px;
            border: 1px solid #eee;
            box-shadow: 0 4px 14px rgba(0,0,0,0.05);
        }

        .section {
            padding: 18px 0;
            border-bottom: 1px solid #eee;
        }

        .section:last-child {
            border-bottom: none;
        }

        .section h2 {
            margin: 0 0 10px;
            font-size: 22px;
            color: #222;
        }

        .section p {
            margin: 0;
            font-size: 15px;
            color: #666;
            line-height: 1.8;
        }

        @media (max-width: 768px) {
            .hero h1 {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>
<div class="page">
    <div class="hero">
        <div class="hero-top">
            <div>
                <h1><%= title %></h1>
                <p><%= subtitle %></p>
            </div>

            <a href="/" class="btn-home">
                <i class="fa-solid fa-house"></i>
                Về trang chủ
            </a>
        </div>
    </div>

    <div class="content-card">
        <% sections.forEach(section => { %>
            <div class="section">
                <h2><%= section.heading %></h2>
                <p><%= section.content %></p>
            </div>
        <% }) %>
    </div>
</div>
</body>
</html>